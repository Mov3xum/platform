# PocketBase configuration
# Lokal utveckling använder de osuffixade vars:na nedan. I Coolify (deploy)
# sätts istället MOVEXUM_ENV + de _STAGING/_PRODUCTION-suffixade paren, och
# appen väljer rätt par utifrån MOVEXUM_ENV (default = staging om osatt).
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8080
# POCKETBASE_URL=http://localhost:8080

# --- Deployment (Coolify): sätt per web-app ---
# Staging och production kör HTTPS via Let's Encrypt på sina sslip.io-hosts
# (slås på i Coolify-UI:t — se infra/SSL.md). Använd alltid https:// här.
# MOVEXUM_ENV=staging            # eller: production
# POCKETBASE_URL_STAGING=https://pocketbase-<staging>.sslip.io
# POCKETBASE_URL_PRODUCTION=https://pocketbase-<production>.sslip.io
# NEXT_PUBLIC_POCKETBASE_URL_STAGING=https://pocketbase-<staging>.sslip.io
# NEXT_PUBLIC_POCKETBASE_URL_PRODUCTION=https://pocketbase-<production>.sslip.io

# Initialt app-admin-lösen (hampus@movexum.se) — sätts som secret i Coolify.
# Migration 13 läser detta vid första containerstart och seedar app-användaren.
# Tom = hoppar över seed. Lämna tom efter första lyckade login.
APP_ADMIN_INITIAL_PASSWORD=

# Encryption (optional, for PocketBase)
POCKETBASE_ENCRYPTION_KEY=

# PocketBase-superuser (hanteras i PocketBase admin-UI /_/)
# Krävs för att markera användare som verified efter e-postverifiering via Resend
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# --- PocketBase-resursen (Coolify): datagallring, hooks/retention_tick.pb.js ---
# Daglig gallring kl. 03:17 UTC (GDPR art. 5.1 e). Alla är valfria; osatta =
# default i hooken. Värden under golvet höjs till golvet.
# MOVEXUM_RETENTION_DISABLED=                  # 1 = stäng av gallringen
# MOVEXUM_RETENTION_BATCH=                     # max rader/kollektion/körning (default 2000)
# MOVEXUM_RETENTION_NOTIFICATIONS_READ_DAYS=   # lästa notiser (default 90)
# MOVEXUM_RETENTION_NOTIFICATIONS_DAYS=        # alla notiser (default 365)
# MOVEXUM_RETENTION_AI_USAGE_DAYS=             # ai_usage_events (default 730, golv 100)
# MOVEXUM_RETENTION_AGENT_ACTIONS_DAYS=        # audit-spåret (default 1095, golv 365)
# MOVEXUM_RETENTION_COMPASS_SECURITY_DAYS=     # compass_security_events (default 365)
# MOVEXUM_RETENTION_WEB_CACHE_DAYS=            # web_cache (default 2)

# Resend e-post API (https://resend.com — skaffa nyckel under API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Standardmottagare för nya inflöden från Startupkompassen (komma-separerad
# lista, en eller flera adresser). Används när en intag-modul saknar egna
# mottagare (fältet "Notifiera inflöde till" i modul-admin). Kan vara tom.
MOVEXUM_INFLOW_EMAIL=inflode@movexum.se

# Bas-URL för Next.js-appen (används i verifieringslänkar skickade via Resend)
NEXT_PUBLIC_APP_URL=https://din-domän.se

# Hemlig nyckel för HMAC-signering av e-postverifieringstoken (minst 32 tecken)
VERIFICATION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS

# Feature flags (modules)
NEXT_PUBLIC_MODULE_STARTUPS_ENABLED=true
NEXT_PUBLIC_MODULE_PROGRAMS_ENABLED=false
NEXT_PUBLIC_MODULE_COACHING_ENABLED=false
NEXT_PUBLIC_MODULE_ACTIVITIES_ENABLED=false
NEXT_PUBLIC_MODULE_DOCUMENTS_ENABLED=false
NEXT_PUBLIC_MODULE_FUNDING_ENABLED=false
NEXT_PUBLIC_MODULE_SUSTAINABILITY_ENABLED=false
NEXT_PUBLIC_MODULE_INTERNATIONALIZATION_ENABLED=false
NEXT_PUBLIC_MODULE_MENTORS_ENABLED=false
NEXT_PUBLIC_MODULE_APPLICATIONS_ENABLED=false
NEXT_PUBLIC_MODULE_REPORTING_ENABLED=false

# Node environment
NODE_ENV=development
