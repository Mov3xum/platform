[Unit]
Description=Movexum Docker-städning (gamla images + build-cache)
Documentation=https://github.com/mov3xum/platform/blob/main/infra/host/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=IMAGE_KEEP_HOURS=168
ExecStart=/opt/movexum/docker-cleanup.sh
Nice=15
IOSchedulingClass=idle
