# Kopiera till /etc/movexum/disk-guard.env och fyll i.
# Läses av disk-guard.sh. INGA hemligheter i repot — den riktiga filen
# ligger bara på hosten (chmod 600).

# Mountpoints att bevaka (mellanslagsseparerat). / täcker oftast allt;
# lägg till /var/lib/docker om Docker ligger på en egen volym.
MOUNTPOINTS="/ /var/lib/docker"

# Trösklar i procent.
WARN_PCT=80
CRIT_PCT=90

# Önskad ledig buffert i GB — varnar även om procenten ser ok ut.
MIN_FREE_GB=5

# Kör docker-cleanup.sh automatiskt när någon mountpoint når CRIT (1=på, 0=av).
AUTO_CLEANUP=1

# --- Larmkanaler (valfria, men sätt minst en) ---

# Generisk webhook (Slack/Discord/Coolify/egen mottagare). POST:ar JSON
# { "severity", "host", "text" }. Slack/Discord läser "text"-fältet.
ALERT_WEBHOOK_URL=""

# E-post via lokala `mail`-kommandot (kräver mailutils/msmtp på hosten).
ALERT_EMAIL=""
